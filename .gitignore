# Gradle / Android build outputs
.gradle/
**/build/
!**/src/**/build/

# Local machine / IDE
local.properties
.DS_Store
.cxx/
.externalNativeBuild/
captures/
.kotlin/
*.iml

# Android Studio / IntelliJ (keep project .idea/.gitignore if present)
.idea/caches/
.idea/libraries/
.idea/modules.xml
.idea/workspace.xml
.idea/navEditor.xml
.idea/assetWizardSettings.xml
.idea/deploymentTargetSelector.xml
.idea/deviceManager.xml
.idea/studiobot.xml

# Bundled debug shell APK (generated by :shell:assembleDebug)
/app/src/main/assets/shell.apk

# Local toolchain packaging output (scripts/package-toolchain.sh)
/dist/

# Secrets / env / signing material
.env*
*.jks
*.keystore
*.p12
*.pem
*.key
credentials.json
service-account*.json
*.so
# Prebuilt helpers shipped in the APK (built by scripts/build-*.sh).
!app/src/main/jniLibs/**/*.so
!app/src/main/assets/toolchain-natives/**/*.so