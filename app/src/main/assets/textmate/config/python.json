{
 "comments": {
  "lineComment": "#",
  "blockComment": [
   "\"\"\"",
   "\"\"\""
  ]
 },
 "brackets": [
  [
   "{",
   "}"
  ],
  [
   "[",
   "]"
  ],
  [
   "(",
   ")"
  ]
 ],
 "autoClosingPairs": [
  {
   "open": "{",
   "close": "}"
  },
  {
   "open": "[",
   "close": "]"
  },
  {
   "open": "(",
   "close": ")"
  },
  {
   "open": "\"",
   "close": "\"",
   "notIn": [
    "string"
   ]
  },
  {
   "open": "'",
   "close": "'",
   "notIn": [
    "string",
    "comment"
   ]
  }
 ],
 "surroundingPairs": [
  [
   "{",
   "}"
  ],
  [
   "[",
   "]"
  ],
  [
   "(",
   ")"
  ],
  [
   "\"",
   "\""
  ],
  [
   "'",
   "'"
  ]
 ],
 "indentationRules": {
  "increaseIndentPattern": "^\\s*(class|def|async def|elif|else|except|finally|for|if|try|while|with|match|case)\\b.*:\\s*(#.*)?$|^.*[\\[({]\\s*$",
  "decreaseIndentPattern": "^\\s*(elif|else|except|finally)\\b.*:\\s*$|^\\s*[}\\])].*$"
 }
}