<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.AndVibe" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorPrimaryVariant">@color/bg</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/bid</item>
        <item name="colorOnSecondary">@color/tape</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="colorSurface">@color/panel</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorSecondary">@color/muted</item>
        <item name="android:editTextColor">@color/ink</item>
        <item name="android:textColorHint">@color/muted</item>
        <item name="colorControlActivated">@color/accent</item>
        <item name="android:forceDarkAllowed">false</item>
        <item name="materialButtonStyle">@style/Widget.AndVibe.Button</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.AndVibe.Button.Outlined</item>
        <item name="textInputStyle">@style/Widget.AndVibe.TextInput</item>
        <item name="checkboxStyle">@style/Widget.AndVibe.CheckBox</item>
        <item name="bottomNavigationStyle">@style/Widget.AndVibe.BottomNav</item>
    </style>

    <style name="Widget.AndVibe.Button" parent="Widget.MaterialComponents.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="backgroundTint">@color/btn</item>
        <item name="cornerRadius">6dp</item>
        <item name="rippleColor">@color/bid</item>
    </style>

    <style name="Widget.AndVibe.Button.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:minHeight">36dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="strokeColor">@color/line</item>
        <item name="strokeWidth">1dp</item>
        <item name="cornerRadius">6dp</item>
        <item name="rippleColor">@color/line</item>
    </style>

    <style name="Widget.AndVibe.Button.Trade" parent="Widget.AndVibe.Button">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/tape</item>
        <item name="android:minHeight">36dp</item>
        <item name="android:minWidth">64dp</item>
        <item name="backgroundTint">@color/bid</item>
        <item name="cornerRadius">2dp</item>
    </style>

    <style name="Widget.AndVibe.TextInput" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/panel</item>
        <item name="boxStrokeColor">@color/box_stroke</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="hintTextColor">@color/muted</item>
        <item name="android:textColorHint">@color/muted</item>
        <item name="boxCornerRadiusTopStart">6dp</item>
        <item name="boxCornerRadiusTopEnd">6dp</item>
        <item name="boxCornerRadiusBottomStart">6dp</item>
        <item name="boxCornerRadiusBottomEnd">6dp</item>
    </style>

    <style name="Widget.AndVibe.CheckBox" parent="Widget.MaterialComponents.CompoundButton.CheckBox">
        <item name="buttonTint">@color/accent</item>
        <item name="android:textColor">@color/ink</item>
    </style>

    <style name="Widget.AndVibe.BottomNav" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="android:background">@color/bg</item>
        <item name="itemIconTint">@color/nav_tint</item>
        <item name="itemTextColor">@color/nav_tint</item>
        <item name="elevation">0dp</item>
        <item name="labelVisibilityMode">labeled</item>
        <item name="itemTextAppearanceActive">@style/TextAppearance.AndVibe.Nav</item>
        <item name="itemTextAppearanceInactive">@style/TextAppearance.AndVibe.Nav</item>
    </style>

    <style name="TextAppearance.AndVibe.Nav" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">11sp</item>
        <item name="android:letterSpacing">0.04</item>
    </style>

    <style name="TextAppearance.AndVibe.Tab" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">13sp</item>
        <item name="android:letterSpacing">0.01</item>
    </style>
</resources>
