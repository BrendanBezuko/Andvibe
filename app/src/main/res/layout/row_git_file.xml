<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="32dp"
    android:orientation="horizontal"
    android:paddingStart="22dp"
    android:paddingEnd="4dp">

    <ImageView
        android:id="@+id/gitIcon"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:importantForAccessibility="no" />

    <TextView
        android:id="@+id/gitPath"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:singleLine="true"
        android:textColor="@color/ink"
        android:textSize="13sp" />

    <ImageButton
        android:id="@+id/gitDiscard"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Discard changes"
        android:scaleType="centerInside"
        android:src="@drawable/ic_git_discard"
        android:tint="@color/muted" />

    <ImageButton
        android:id="@+id/gitMark"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Stage"
        android:scaleType="centerInside"
        android:src="@drawable/ic_git_plus"
        android:tint="@color/muted" />

    <TextView
        android:id="@+id/gitStatus"
        android:layout_width="18dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="2dp"
        android:gravity="center"
        android:textSize="12sp"
        android:textStyle="bold" />
</LinearLayout>
