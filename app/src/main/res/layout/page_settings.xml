<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Settings"
            android:textColor="@color/ink"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="API keys"
            android:textColor="@color/ink"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="One key per provider. After save, keys are write-only — leave a field blank to keep the stored value. Closing this screen saves them."
            android:textColor="@color/muted"
            android:textSize="13sp" />

        <LinearLayout
            android:id="@+id/apiKeyList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <Button
            android:id="@+id/saveApiKeys"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="40dp"
            android:text="Save keys"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/keyNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/muted"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Background"
            android:textColor="@color/ink"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/backgroundStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="monospace"
            android:lineSpacingExtra="2dp"
            android:textColor="@color/ink"
            android:textSize="13sp" />

        <Button
            android:id="@+id/allowBackground"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="40dp"
            android:text="Allow background"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Builds, agent runs, clones, and push or pull keep going after you leave AndVibe. A notification pings when each one finishes. Turning off battery optimization stops Android from pausing the network during long Cloud Run builds."
            android:textColor="@color/muted"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Editor"
            android:textColor="@color/ink"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Font size"
                android:textColor="@color/ink"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/editorFontDown"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="Decrease font size"
                android:fontFamily="monospace"
                android:gravity="center"
                android:text="−"
                android:textColor="@color/accent"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/editorFontValue"
                android:layout_width="40dp"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:gravity="center"
                android:textColor="@color/ink"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/editorFontUp"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="Increase font size"
                android:fontFamily="monospace"
                android:gravity="center"
                android:text="+"
                android:textColor="@color/accent"
                android:textSize="18sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Tab width"
                android:textColor="@color/ink"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/editorTabDown"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="Decrease tab width"
                android:fontFamily="monospace"
                android:gravity="center"
                android:text="−"
                android:textColor="@color/accent"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/editorTabValue"
                android:layout_width="40dp"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:gravity="center"
                android:textColor="@color/ink"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/editorTabUp"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="Increase tab width"
                android:fontFamily="monospace"
                android:gravity="center"
                android:text="+"
                android:textColor="@color/accent"
                android:textSize="18sp" />
        </LinearLayout>

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/editorSpaces"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tab key inserts spaces" />

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/editorWrap"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Word wrap" />

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/editorLineNumbers"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Line numbers" />

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/editorHighlight"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Syntax highlighting" />

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/editorAutoClose"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Auto-close brackets and quotes" />

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/editorAutoIndent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Auto-indent" />

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/editorSuggestions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Word suggestions while typing" />

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/editorKeyBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Key bar above the keyboard (tab, arrows, symbols)" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Changes apply to the Files editor right away."
            android:textColor="@color/muted"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="MCP"
            android:textColor="@color/ink"
            android:textSize="14sp" />

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/mcpEnabled"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Run MCP server" />

        <TextView
            android:id="@+id/mcpStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="monospace"
            android:lineSpacingExtra="2dp"
            android:text="Starting"
            android:textColor="@color/ink"
            android:textIsSelectable="true"
            android:textSize="13sp" />

        <Button
            android:id="@+id/mcpRetry"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="40dp"
            android:text="Try again"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="The server listens on this device. Cursor on the computer reaches it with adb forward. adb reverse takes this same port on the device, so the server cannot bind. A request time here means something connected."
            android:textColor="@color/muted"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Git"
            android:textColor="@color/ink"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Global identity for every project. Set this project's origin on the Git tab (tap the remote line or ⋯ → Set origin)."
            android:textColor="@color/muted"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="monospace"
            android:text="git_name"
            android:textColor="@color/muted"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/gitName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_field"
            android:hint="Name"
            android:importantForAutofill="no"
            android:inputType="textPersonName"
            android:padding="10dp"
            android:singleLine="true"
            android:textColor="@color/ink"
            android:textColorHint="@color/muted"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="monospace"
            android:text="git_email"
            android:textColor="@color/muted"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/gitEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_field"
            android:hint="Email"
            android:importantForAutofill="no"
            android:inputType="textEmailAddress"
            android:padding="10dp"
            android:singleLine="true"
            android:textColor="@color/ink"
            android:textColorHint="@color/muted"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="monospace"
            android:text="git_user"
            android:textColor="@color/muted"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/gitHttpsUser"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_field"
            android:hint="GitHub username"
            android:importantForAutofill="no"
            android:inputType="text"
            android:padding="10dp"
            android:singleLine="true"
            android:textColor="@color/ink"
            android:textColorHint="@color/muted"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="monospace"
            android:text="git_token"
            android:textColor="@color/muted"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/gitHttpsToken"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_field"
            android:hint="GitHub token (PAT)"
            android:importantForAutofill="no"
            android:inputType="textPassword"
            android:padding="10dp"
            android:singleLine="true"
            android:textColor="@color/ink"
            android:textColorHint="@color/muted"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="monospace"
            android:text="git_ssh"
            android:textColor="@color/muted"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/gitSsh"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_field"
            android:gravity="top|start"
            android:hint="SSH private key (optional)"
            android:importantForAutofill="no"
            android:inputType="textMultiLine"
            android:minLines="3"
            android:padding="10dp"
            android:textColor="@color/ink"
            android:textColorHint="@color/muted"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Identity stays on this phone. HTTPS remotes use the PAT; SSH remotes (git@…) use the private key. Fork on the Git tab needs Build Tools + the PAT."
            android:textColor="@color/muted"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/gitSetupGuide"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:text="How to get a GitHub token →"
            android:textColor="@color/accent"
            android:textSize="13sp" />

        <Button
            android:id="@+id/saveGit"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="40dp"
            android:text="Save git"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/gitSettingsNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/muted"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="System prompts"
            android:textColor="@color/ink"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Every system prompt the app sends to a model. Edit any of them any time. Closing this screen saves them. Reset restores the built-in default for that prompt."
            android:textColor="@color/muted"
            android:textSize="13sp" />

        <LinearLayout
            android:id="@+id/promptList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/savePrompts"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="40dp"
                android:text="Save prompts"
                android:textSize="13sp" />

            <Button
                android:id="@+id/resetPrompts"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:minHeight="40dp"
                android:text="Reset all"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/promptNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/muted"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
