<?xml version="1.0" encoding="utf-8"?>
<!-- One Board status column; BoardPageController inflates one per CardStatus. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="252dp"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="8dp"
    android:paddingEnd="8dp"
    android:paddingBottom="8dp">

    <View
        android:id="@+id/colStripe"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="@color/accent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="8dp">

        <TextView
            android:id="@+id/colTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="monospace"
            android:includeFontPadding="false"
            android:textColor="@color/accent"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/colCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge"
            android:fontFamily="monospace"
            android:includeFontPadding="false"
            android:paddingStart="7dp"
            android:paddingTop="2dp"
            android:paddingEnd="7dp"
            android:paddingBottom="2dp"
            android:textColor="@color/muted"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/colAdd"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:fontFamily="monospace"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="+"
            android:textColor="@color/accent"
            android:textSize="22sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/colEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:text="None"
        android:textColor="@color/muted"
        android:textSize="13sp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/colCards"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="8dp" />
    </ScrollView>
</LinearLayout>
