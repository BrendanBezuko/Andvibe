<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="8dp"
    android:paddingEnd="12dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/buildScope"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:letterSpacing="0.06"
            android:maxLines="1"
            android:textColor="@color/muted"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/projectLine"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="No repo yet"
            android:textColor="@color/ink"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/projectKind"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/muted"
            android:textSize="12sp"
            android:visibility="gone" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:background="@color/line" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/buildStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:letterSpacing="0.06"
                android:text="● NOT BUILT"
                android:textColor="@color/muted"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/apkPath"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:ellipsize="middle"
                android:fontFamily="monospace"
                android:gravity="end"
                android:singleLine="true"
                android:text="No APK yet"
                android:textColor="@color/muted"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/buildApk"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.4"
            android:text="Build APK" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/reviseBuild"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="48dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:contentDescription="Revise"
            android:enabled="false"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:minHeight="40dp"
            android:padding="0dp"
            app:icon="@drawable/ic_git_sparkle"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconTint="@color/ink" />

        <Button
            android:id="@+id/installApk"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:enabled="false"
            android:minHeight="40dp"
            android:text="Install" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1"
        android:background="@drawable/bg_tape"
        android:orientation="vertical"
        android:padding="8dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:letterSpacing="0.08"
            android:paddingBottom="6dp"
            android:text="BUILD LOG"
            android:textColor="@color/muted"
            android:textSize="11sp"
            android:textStyle="bold" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/line" />

        <ScrollView
            android:id="@+id/buildScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="6dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:scrollbars="vertical">

            <TextView
                android:id="@+id/buildLog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:hint="Press Build APK to start. Output shows up here."
                android:lineSpacingExtra="2dp"
                android:textColor="@color/tape_ink"
                android:textColorHint="@color/muted"
                android:textIsSelectable="true"
                android:textSize="12sp" />
        </ScrollView>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/savedHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:minHeight="32dp"
        android:orientation="horizontal"
        android:paddingEnd="4dp">

        <ImageView
            android:id="@+id/savedChevron"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_git_chevron"
            android:tint="@color/ink" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:letterSpacing="0.06"
            android:text="SAVED APKS"
            android:textColor="@color/ink"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/savedCount"
            android:layout_width="wrap_content"
            android:layout_height="18dp"
            android:background="@drawable/bg_badge"
            android:gravity="center"
            android:minWidth="18dp"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:text="0"
            android:textColor="@color/ink"
            android:textSize="11sp" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/savedScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_card"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/savedApks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingEnd="8dp" />
    </ScrollView>

    <LinearLayout
        android:id="@+id/historyHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:minHeight="32dp"
        android:orientation="horizontal"
        android:paddingEnd="4dp">

        <ImageView
            android:id="@+id/historyChevron"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_git_chevron"
            android:tint="@color/ink" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:letterSpacing="0.06"
            android:text="BUILD HISTORY"
            android:textColor="@color/ink"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/historyCount"
            android:layout_width="wrap_content"
            android:layout_height="18dp"
            android:background="@drawable/bg_badge"
            android:gravity="center"
            android:minWidth="18dp"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:text="0"
            android:textColor="@color/ink"
            android:textSize="11sp" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/historyScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_card"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/buildHistory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingEnd="8dp" />
    </ScrollView>
</LinearLayout>
